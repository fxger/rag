# ── Application ──────────────────────────────────────────────────────
APP_NAME=Enterprise RAG System
APP_VERSION=0.1.0
DEBUG=true
LOG_LEVEL=INFO

# ── PostgreSQL (VM2: 192.168.86.134) ────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@192.168.86.134:5432/postgres
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# ── Redis (VM1: 192.168.86.132) ────────────────────────────────────
REDIS_URL=redis://192.168.86.132:6379/0
REDIS_CACHE_DB=1
REDIS_PASSWORD=
REDIS_MAX_CONNECTIONS=50

# ── Milvus (VM1: 192.168.86.132) ───────────────────────────────────
MILVUS_HOST=192.168.86.132
MILVUS_PORT=19530
MILVUS_COLLECTION=enterprise_rag
MILVUS_DIMENSION=3072

# ── MinIO (VM1: 192.168.86.132) ────────────────────────────────────
MINIO_ENDPOINT=192.168.86.132:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=rag-documents
MINIO_SECURE=false

# ── OpenAI ──────────────────────────────────────────────────────────
OPENAI_API_KEY=your-api-key
OPENAI_BASE_URL=
EMBEDDING_MODEL=text-embedding-3-large
LLM_MODEL=gpt-4-turbo-preview
EMBEDDING_DIMENSION=3072
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.1

# ── Kafka (VM2: 192.168.86.134) ────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=192.168.86.134:9092
KAFKA_DOCUMENT_TOPIC=rag.document.processing
KAFKA_ENABLED=false

# ── JWT Authentication ──────────────────────────────────────────────
JWT_SECRET_KEY=change-me-in-production-use-a-real-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ── RAG Settings ────────────────────────────────────────────────────
CHUNK_SIZE=512
CHUNK_OVERLAP=50
DEFAULT_TOP_K=10
RERANK_TOP_N=5

# ── Rate Limiting ───────────────────────────────────────────────────
RATE_LIMIT_USER_PER_MINUTE=100
RATE_LIMIT_GLOBAL_PER_MINUTE=10000